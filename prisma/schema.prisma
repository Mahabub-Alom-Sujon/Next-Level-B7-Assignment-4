// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  password         String
  phone            String?            @unique
  profileImage     String?
  address          String?
  city             String?
  district         String?
  postalCode       String?
  role             UserRole           @default(CUSTOMER)
  status           UserStatus         @default(ACTIVE)
  isVerified       Boolean            @default(false)
  isActive         Boolean            @default(true)
  technician       TechnicianProfile?
  customerBookings Booking[]          @relation("CustomerBookings")
  reviews          Review[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
}

model TechnicianProfile {
  id            String             @id @default(uuid())
  bio           String?
  experience    Int                @default(0)
  hourlyRate    Int? // stored in smallest currency unit (e.g., 50000 = 500.00 BDT)
  skills        String?
  nationalId    String?
  certification String?
  averageRating Float              @default(0)
  totalReviews  Int                @default(0)
  completedJobs Int                @default(0)
  isAvailable   Boolean            @default(true)
  services      Service[]
  bookings      Booking[]
  reviews       Review[]
  availability  AvailabilitySlot[]
  userId        String             @unique
  user          Users              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
}

model AvailabilitySlot {
  id           String   @id @default(cuid())
  technicianId String
  dayOfWeek    Int // 0 = Sunday ... 6 = Saturday
  startTime    String // e.g. "09:00"
  endTime      String // e.g. "17:00"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relation
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, dayOfWeek, startTime, endTime])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  icon        String?
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Service {
  id           String            @id @default(uuid())
  title        String
  description  String?
  image        String? // URL or path of the service image
  price        Int // smallest currency unit (e.g., 150000 = 1,500.00 BDT)
  duration     Int // Minutes
  serviceArea  String?
  isAvailable  Boolean           @default(true)
  featured     Boolean?          @default(false)
  bookings     Booking[]
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
}

model Booking {
  id           String            @id @default(uuid())
  bookingDate  DateTime
  bookingTime  String?
  note         String?
  // totalAmount  Decimal           @db.Decimal(10, 2)
  status       BookingStatus     @default(REQUESTED)
  isAvailable  Boolean           @default(true)
  isBooked     Boolean           @default(false)
  payments     Payment?
  review       Review?
  customerId   String
  customer     Users             @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
}

model Payment {
  id            String          @id @default(uuid())
  bookingId     String          @unique
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactionId String?         @unique
  amount        Decimal         @db.Decimal(10, 2)
  provider      PaymentProvider @default(STRIPE)
  method        PaymentMethod   @default(CARD)
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Review {
  id           String            @id @default(uuid())
  rating       Int
  comment      String?
  bookingId    String            @unique
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId   String
  customer     Users             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentMethod {
  CARD
  MOBILE_BANKING
  BANK
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
